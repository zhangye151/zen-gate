+// ---- Web login session (container patch) -----------------------------------
+
+// adminAuthed reports whether the request carries the admin session cookie, an
+// HMAC of the configured password. The cookie is HttpOnly + SameSite=Lax: page
+// JS can never read it, and cross-site POSTs (the only kind that mutates
+// config) do not carry it — so a hostile page cannot drive the panel either.
+func (s *Server) adminAuthed(r *http.Request) bool {
+	tok := s.adminSessionToken()
+	if tok == "" {
+		return false
+	}
+	c, err := r.Cookie(cookieName)
+	if err != nil {
+		return false
+	}
+	return subtle.ConstantTimeCompare([]byte(c.Value), []byte(tok)) == 1
+}
+
+func (s *Server) adminSessionToken() string {
+	pw := s.Store.Config().AdminPassword
+	if pw == "" {
+		return ""
+	}
+	mac := hmac.New(sha256.New, []byte(pw))
+	mac.Write([]byte("zen-gate-admin-session-v1"))
+	return hex.EncodeToString(mac.Sum(nil))
+}
+
+// adminChallenge answers an unauthenticated admin request: the dashboard page
+// (path "/") is redirected to the web login page; API calls get a plain 401.
+func (s *Server) adminChallenge(w http.ResponseWriter, r *http.Request) {
+	if r.URL.Path == "/" || r.URL.Path == "/admin" || (r.Method == http.MethodGet && strings.Contains(r.Header.Get("Accept"), "text/html")) {
+		http.Redirect(w, r, "/admin/login", http.StatusSeeOther)
+		return
+	}
+	writeJSON(w, 401, map[string]any{"error": "admin authentication required"})
+}
+
+// adminLoginPage renders the password form (GET /admin/login).
+func (s *Server) adminLoginPage(w http.ResponseWriter, r *http.Request) {
+	if s.adminAuthed(r) {
+		http.Redirect(w, r, "/", http.StatusSeeOther)
+		return
+	}
+	errHTML := ""
+	if r.URL.Query().Get("e") == "1" {
+		errHTML = `<div class="err">密码错误，请重试</div>`
+	}
+	w.Header().Set("content-type", "text/html; charset=utf-8")
+	_, _ = w.Write([]byte(strings.Replace(adminLoginHTML, "{{ERR}}", errHTML, 1)))
+}
+
+// adminLogin validates the submitted password and sets the session cookie
+// (POST /admin/login).
+func (s *Server) adminLogin(w http.ResponseWriter, r *http.Request) {
+	pw := s.Store.Config().AdminPassword
+	if pw == "" {
+		http.Redirect(w, r, "/", http.StatusSeeOther)
+		return
+	}
+	if err := r.ParseForm(); err != nil {
+		writeJSON(w, 400, map[string]any{"error": "bad form"})
+		return
+	}
+	if r.PostForm.Get("password") != pw {
+		http.Redirect(w, r, "/admin/login?e=1", http.StatusSeeOther)
+		return
+	}
+	http.SetCookie(w, &http.Cookie{
+		Name:     cookieName,
+		Value:    s.adminSessionToken(),
+		Path:     "/",
+		MaxAge:   7 * 24 * 3600, // 7 days
+		HttpOnly: true,
+		SameSite: http.SameSiteLaxMode,
+	})
+	http.Redirect(w, r, "/", http.StatusSeeOther)
+}
+
+// adminLogout clears the session cookie (GET /admin/logout).
+func (s *Server) adminLogout(w http.ResponseWriter, r *http.Request) {
+	http.SetCookie(w, &http.Cookie{Name: cookieName, Path: "/", MaxAge: -1})
+	http.Redirect(w, r, "/admin/login", http.StatusSeeOther)
+}
